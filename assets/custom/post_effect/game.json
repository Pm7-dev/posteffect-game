{
    "targets": {
        "data": {
            "width": 1920,
            "height": 2,
            "persistent": true
        },
        "data_swap": {
            "width": 1920,
			"height": 2,
            "persistent": true
        }
    },
    "passes": [
        {
            "vertex_shader": "minecraft:core/screenquad",
            "fragment_shader": "custom:post/game/update",
            "inputs": [
                {
                    "sampler_name": "Data",
                    "target": "data"
                },
                {
                    "sampler_name": "Map",
                    "location": "custom:game/map",
                    "width": 128,
                    "height": 128
                },
                {
                    "sampler_name": "Minecraft",
                    "target": "minecraft:main"
                }
            ],
            "output": "data_swap"
        },
        {
            "vertex_shader": "minecraft:core/screenquad",
            "fragment_shader": "minecraft:post/blit",
            "inputs": [
                {
                    "sampler_name": "In",
                    "target": "data_swap"
                }
            ],
            "uniforms": {
                "BlitConfig": [
                    {
                        "name": "ColorModulate",
                        "type": "vec4",
                        "value": [ 1.0, 1.0, 1.0, 1.0 ]
                    }
                ]
            },
            "output": "data"
        },






        {
            "vertex_shader": "minecraft:core/screenquad",
            "fragment_shader": "custom:post/game/render",
            "inputs": [
                {
                    "sampler_name": "Data",
                    "target": "data"
                }
            ],
            "output": "minecraft:main"
        }
    ]
}
