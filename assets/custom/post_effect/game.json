{
    "targets": {
        "data": {
            "width": 512,
            "height": 512,
            "persistent": true
        },
        "data_swap": {
            "width": 512,
			"height": 512,
            "persistent": true
        }
    },
    "passes": [
        {
            "vertex_shader": "minecraft:core/screenquad",
            "fragment_shader": "custom:post/game/input",
            "inputs": [
                {
                    "sampler_name": "Data",
                    "target": "data"
                },
                {
                    "sampler_name": "Minecraft",
                    "target": "minecraft:main"
                }
            ],
            "output": "data_swap"
        },
        {
            "vertex_shader": "minecraft:core/screenquad",
            "fragment_shader": "custom:post/util/shortblit",
            "inputs": [{"sampler_name": "In","target": "data_swap"}],
            "output": "data"
        },





        {
            "vertex_shader": "minecraft:core/screenquad",
            "fragment_shader": "custom:post/game/update_map",
            "inputs": [
                {
                    "sampler_name": "Data",
                    "target": "data"
                },
                {
                    "sampler_name": "Map",
                    "location": "custom:game/map",
                    "width": 256,
                    "height": 256
                }

            ],
            "output": "data_swap"
        },
        {
            "vertex_shader": "minecraft:core/screenquad",
            "fragment_shader": "custom:post/util/shortblit",
            "inputs": [{"sampler_name": "In","target": "data_swap"}],
            "output": "data"
        },





        {
            "vertex_shader": "minecraft:core/screenquad",
            "fragment_shader": "custom:post/game/update_player",
            "inputs": [
                {
                    "sampler_name": "Data",
                    "target": "data"
                },
                {
                    "sampler_name": "Map",
                    "location": "custom:game/map",
                    "width": 256,
                    "height": 256
                }
            ],
            "output": "data_swap"
        },
        {
            "vertex_shader": "minecraft:core/screenquad",
            "fragment_shader": "custom:post/util/shortblit",
            "inputs": [{"sampler_name": "In","target": "data_swap"}],
            "output": "data"
        },





        {
            "vertex_shader": "minecraft:core/screenquad",
            "fragment_shader": "custom:post/game/send_raycasts",
            "inputs": [
                {
                    "sampler_name": "Data",
                    "target": "data"
                }
            ],
            "output": "data_swap"
        },
        {
            "vertex_shader": "minecraft:core/screenquad",
            "fragment_shader": "custom:post/util/shortblit",
            "inputs": [{"sampler_name": "In","target": "data_swap"}],
            "output": "data"
        },






        {
            "vertex_shader": "minecraft:core/screenquad",
            "fragment_shader": "custom:post/game/render_map",
            "inputs": [
                {
                    "sampler_name": "Data",
                    "target": "data"
                }
            ],
            "output": "minecraft:main"
        }
    ]
}
